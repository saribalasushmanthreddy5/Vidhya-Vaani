# ==========================================
# VidyaVaani Server-Side Backend Configuration
# ==========================================
# These keys are securely loaded ONLY by the backend server.
# They are NEVER sent or displayed to the frontend client UI.

# 1. Google Gemini API Key (Primary LLM)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Groq Cloud API Key (Ultra-fast fallback LLM)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# 3. Model Configuration (Optional)
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# 4. Retrieval Similarity Threshold (Calibrated for Indian regional + English)
SIM_THRESHOLD=0.782
